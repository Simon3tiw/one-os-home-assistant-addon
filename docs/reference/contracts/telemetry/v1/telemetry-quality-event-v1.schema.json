{
  "$id": "https://one.os/contracts/telemetry/v1/telemetry-quality-event-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "configVersion": {
      "maximum": 9223372036854775807,
      "minimum": 0,
      "type": "integer"
    },
    "installationId": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "observedAt": {
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,3})?Z$",
      "type": "string"
    },
    "pointId": {
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
      "type": "string"
    },
    "projectionSha256": {
      "pattern": "^[A-Za-z0-9_-]{43}$",
      "type": "string"
    },
    "receivedAtEdge": {
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,3})?Z$",
      "type": "string"
    },
    "sampleId": {
      "pattern": "^[A-Za-z0-9_-]{43}$",
      "type": "string"
    },
    "schemaVersion": {
      "const": "1.0"
    },
    "sequence": {
      "maximum": 9223372036854775807,
      "minimum": 0,
      "type": "integer"
    },
    "snapshotId": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "streamEpochId": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "valueQuality": {
      "enum": [
        "invalid",
        "unknown",
        "unavailable"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "sampleId",
    "installationId",
    "configVersion",
    "snapshotId",
    "projectionSha256",
    "pointId",
    "streamEpochId",
    "sequence",
    "observedAt",
    "receivedAtEdge",
    "valueQuality"
  ],
  "title": "ONE.OS TelemetryQualityEvent v1",
  "type": "object"
}
