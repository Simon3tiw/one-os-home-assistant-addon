{
  "$id": "https://one.os/contracts/telemetry/v1/telemetry-gap-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "configVersion": {
      "maximum": 9223372036854775807,
      "minimum": 0,
      "type": "integer"
    },
    "detectedAt": {
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,3})?Z$",
      "type": "string"
    },
    "firstMissingSequence": {
      "maximum": 9223372036854775807,
      "minimum": 0,
      "type": "integer"
    },
    "installationId": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "lastMissingSequence": {
      "maximum": 9223372036854775807,
      "minimum": 0,
      "type": "integer"
    },
    "pointId": {
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
      "type": "string"
    },
    "projectionSha256": {
      "pattern": "^[A-Za-z0-9_-]{43}$",
      "type": "string"
    },
    "reason": {
      "enum": [
        "outbox_capacity",
        "retention_expired",
        "storage_failure",
        "clock_discontinuity",
        "operator_reset"
      ]
    },
    "schemaVersion": {
      "const": "1.0"
    },
    "snapshotId": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "streamEpochId": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "installationId",
    "configVersion",
    "snapshotId",
    "projectionSha256",
    "pointId",
    "streamEpochId",
    "firstMissingSequence",
    "lastMissingSequence",
    "detectedAt",
    "reason"
  ],
  "title": "ONE.OS TelemetryGap v1",
  "type": "object"
}
