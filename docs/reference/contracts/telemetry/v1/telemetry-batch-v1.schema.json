{
  "$id": "https://one.os/contracts/telemetry/v1/telemetry-batch-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "batchId": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "createdAt": {
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,3})?Z$",
      "type": "string"
    },
    "credentialId": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "gaps": {
      "items": {
        "$id": "https://one.os/contracts/telemetry/v1/telemetry-gap-v1.schema.json",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "configVersion": {
            "maximum": 9223372036854775807,
            "minimum": 0,
            "type": "integer"
          },
          "detectedAt": {
            "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,3})?Z$",
            "type": "string"
          },
          "firstMissingSequence": {
            "maximum": 9223372036854775807,
            "minimum": 0,
            "type": "integer"
          },
          "installationId": {
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "type": "string"
          },
          "lastMissingSequence": {
            "maximum": 9223372036854775807,
            "minimum": 0,
            "type": "integer"
          },
          "pointId": {
            "maxLength": 80,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
            "type": "string"
          },
          "projectionSha256": {
            "pattern": "^[A-Za-z0-9_-]{43}$",
            "type": "string"
          },
          "reason": {
            "enum": [
              "outbox_capacity",
              "retention_expired",
              "storage_failure",
              "clock_discontinuity",
              "operator_reset"
            ]
          },
          "schemaVersion": {
            "const": "1.0"
          },
          "snapshotId": {
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "type": "string"
          },
          "streamEpochId": {
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "type": "string"
          }
        },
        "required": [
          "schemaVersion",
          "installationId",
          "configVersion",
          "snapshotId",
          "projectionSha256",
          "pointId",
          "streamEpochId",
          "firstMissingSequence",
          "lastMissingSequence",
          "detectedAt",
          "reason"
        ],
        "title": "ONE.OS TelemetryGap v1",
        "type": "object"
      },
      "maxItems": 500,
      "type": "array"
    },
    "installationId": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "payloadSha256": {
      "pattern": "^[A-Za-z0-9_-]{43}$",
      "type": "string"
    },
    "qualityEvents": {
      "items": {
        "$id": "https://one.os/contracts/telemetry/v1/telemetry-quality-event-v1.schema.json",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "configVersion": {
            "maximum": 9223372036854775807,
            "minimum": 0,
            "type": "integer"
          },
          "installationId": {
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "type": "string"
          },
          "observedAt": {
            "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,3})?Z$",
            "type": "string"
          },
          "pointId": {
            "maxLength": 80,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
            "type": "string"
          },
          "projectionSha256": {
            "pattern": "^[A-Za-z0-9_-]{43}$",
            "type": "string"
          },
          "receivedAtEdge": {
            "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,3})?Z$",
            "type": "string"
          },
          "sampleId": {
            "pattern": "^[A-Za-z0-9_-]{43}$",
            "type": "string"
          },
          "schemaVersion": {
            "const": "1.0"
          },
          "sequence": {
            "maximum": 9223372036854775807,
            "minimum": 0,
            "type": "integer"
          },
          "snapshotId": {
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "type": "string"
          },
          "streamEpochId": {
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "type": "string"
          },
          "valueQuality": {
            "enum": [
              "invalid",
              "unknown",
              "unavailable"
            ]
          }
        },
        "required": [
          "schemaVersion",
          "sampleId",
          "installationId",
          "configVersion",
          "snapshotId",
          "projectionSha256",
          "pointId",
          "streamEpochId",
          "sequence",
          "observedAt",
          "receivedAtEdge",
          "valueQuality"
        ],
        "title": "ONE.OS TelemetryQualityEvent v1",
        "type": "object"
      },
      "maxItems": 500,
      "type": "array"
    },
    "samples": {
      "items": {
        "$id": "https://one.os/contracts/telemetry/v1/telemetry-sample-v1.schema.json",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "oneOf": [
          {
            "not": {
              "required": [
                "decimalValue"
              ]
            },
            "required": [
              "booleanValue"
            ]
          },
          {
            "not": {
              "required": [
                "booleanValue"
              ]
            },
            "required": [
              "decimalValue"
            ]
          }
        ],
        "properties": {
          "booleanValue": {
            "type": "boolean"
          },
          "configVersion": {
            "maximum": 9223372036854775807,
            "minimum": 0,
            "type": "integer"
          },
          "decimalValue": {
            "maxLength": 28,
            "pattern": "^(?:0|-?[1-9][0-9]{0,17}|-?0\\.[0-9]{0,8}[1-9]|-?[1-9](?=[0-9.]{1,18}$)[0-9]{0,17}\\.[0-9]{0,8}[1-9])$",
            "type": "string"
          },
          "installationId": {
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "type": "string"
          },
          "observedAt": {
            "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,3})?Z$",
            "type": "string"
          },
          "pointId": {
            "maxLength": 80,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
            "type": "string"
          },
          "projectionSha256": {
            "pattern": "^[A-Za-z0-9_-]{43}$",
            "type": "string"
          },
          "receivedAtEdge": {
            "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,3})?Z$",
            "type": "string"
          },
          "sampleId": {
            "pattern": "^[A-Za-z0-9_-]{43}$",
            "type": "string"
          },
          "schemaVersion": {
            "const": "1.0"
          },
          "sequence": {
            "maximum": 9223372036854775807,
            "minimum": 0,
            "type": "integer"
          },
          "snapshotId": {
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "type": "string"
          },
          "streamEpochId": {
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "type": "string"
          },
          "valueQuality": {
            "enum": [
              "good",
              "stale"
            ]
          }
        },
        "required": [
          "schemaVersion",
          "sampleId",
          "installationId",
          "configVersion",
          "snapshotId",
          "projectionSha256",
          "pointId",
          "streamEpochId",
          "sequence",
          "observedAt",
          "receivedAtEdge",
          "valueQuality"
        ],
        "title": "ONE.OS TelemetrySample v1",
        "type": "object"
      },
      "maxItems": 500,
      "type": "array"
    },
    "schemaVersion": {
      "const": "1.0"
    },
    "installationRevision": {
      "maximum": 9223372036854775807,
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "schemaVersion",
    "batchId",
    "installationId",
    "installationRevision",
    "credentialId",
    "createdAt",
    "payloadSha256",
    "samples",
    "qualityEvents",
    "gaps"
  ],
  "title": "ONE.OS TelemetryBatch v1",
  "type": "object"
}
