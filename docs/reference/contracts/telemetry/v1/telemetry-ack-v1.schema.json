{
  "$id": "https://one.os/contracts/telemetry/v1/telemetry-ack-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "acceptedAt": {
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,3})?Z$",
      "type": "string"
    },
    "acceptedGaps": {
      "maximum": 500,
      "minimum": 0,
      "type": "integer"
    },
    "acceptedQualityEvents": {
      "maximum": 500,
      "minimum": 0,
      "type": "integer"
    },
    "acceptedSamples": {
      "maximum": 500,
      "minimum": 0,
      "type": "integer"
    },
    "batchId": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "credentialId": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "duplicateGaps": {
      "maximum": 500,
      "minimum": 0,
      "type": "integer"
    },
    "duplicateQualityEvents": {
      "maximum": 500,
      "minimum": 0,
      "type": "integer"
    },
    "duplicateSamples": {
      "maximum": 500,
      "minimum": 0,
      "type": "integer"
    },
    "ingestCursor": {
      "maximum": 9223372036854775807,
      "minimum": 0,
      "type": "integer"
    },
    "installationId": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "requestSha256": {
      "pattern": "^[A-Za-z0-9_-]{43}$",
      "type": "string"
    },
    "schemaVersion": {
      "const": "1.0"
    }
  },
  "required": [
    "schemaVersion",
    "installationId",
    "credentialId",
    "batchId",
    "requestSha256",
    "acceptedSamples",
    "duplicateSamples",
    "acceptedQualityEvents",
    "duplicateQualityEvents",
    "acceptedGaps",
    "duplicateGaps",
    "ingestCursor",
    "acceptedAt"
  ],
  "title": "ONE.OS TelemetryAcknowledgement v1",
  "type": "object"
}
