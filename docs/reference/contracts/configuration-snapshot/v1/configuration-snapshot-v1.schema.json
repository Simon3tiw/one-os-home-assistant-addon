{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://one-os.local/contracts/configuration-snapshot/v1/configuration-snapshot-v1.schema.json",
  "title": "ONE.OS selected configuration snapshot V1",
  "description": "Structural contract only. Consumers MUST also execute semantic_validator.py for ordering, global ID uniqueness, references, the closed V1 point metadata matrix, and strict UTC semantics.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion","snapshotId","installationId","configVersion","capturedAt","projectionSha256","structures","spaces","assets","points"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "snapshotId": {"type":"string","pattern":"^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "installationId": {"type":"string","pattern":"^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "configVersion": {"type":"integer","minimum":0,"maximum":18446744073709551615},
    "capturedAt": {"type":"string","format":"date-time","pattern":"Z$"},
    "projectionSha256": {"type":"string","pattern":"^[A-Za-z0-9_-]{43}$"},
    "structures": {"type":"array","maxItems":256,"items":{"$ref":"#/$defs/structure"}},
    "spaces": {"type":"array","maxItems":2048,"items":{"$ref":"#/$defs/space"}},
    "assets": {"type":"array","maxItems":4096,"items":{"$ref":"#/$defs/asset"}},
    "points": {"type":"array","maxItems":20000,"items":{"$ref":"#/$defs/point"}}
  },
  "$defs": {
    "id": {"type":"string","minLength":1,"maxLength":80,"pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "name": {"type":"string","minLength":1,"maxLength":160,"pattern":"^[^\\u0000-\\u001f\\u007f]*$"},
    "class": {"type":"string","minLength":1,"maxLength":120,"pattern":"^[A-Za-z][A-Za-z0-9._:-]*$"},
    "structure": {"type":"object","additionalProperties":false,"required":["id","name","ontologyClass"],"properties":{"id":{"$ref":"#/$defs/id"},"name":{"$ref":"#/$defs/name"},"ontologyClass":{"$ref":"#/$defs/class"}}},
    "space": {"type":"object","additionalProperties":false,"required":["id","structureId","name","ontologyClass"],"properties":{"id":{"$ref":"#/$defs/id"},"structureId":{"$ref":"#/$defs/id"},"name":{"$ref":"#/$defs/name"},"ontologyClass":{"$ref":"#/$defs/class"}}},
    "asset": {"type":"object","additionalProperties":false,"required":["id","spaceId","name","ontologyClass"],"properties":{"id":{"$ref":"#/$defs/id"},"spaceId":{"$ref":"#/$defs/id"},"name":{"$ref":"#/$defs/name"},"ontologyClass":{"$ref":"#/$defs/class"}}},
    "point": {"type":"object","additionalProperties":false,"required":["id","assetId","name","ontologyClass","valueType","canonicalUnit","displayUnit","decimals"],"properties":{"id":{"$ref":"#/$defs/id"},"assetId":{"$ref":"#/$defs/id"},"name":{"$ref":"#/$defs/name"},"ontologyClass":{"$ref":"#/$defs/class"},"valueType":{"enum":["boolean","number","string","enum"]},"canonicalUnit":{"type":["string","null"],"maxLength":40},"displayUnit":{"type":["string","null"],"maxLength":40},"decimals":{"type":["integer","null"],"minimum":0,"maximum":9}}}
  }
}
